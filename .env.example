# Copy to .env and fill in the two REPLACE values, then:  source .env
# (Or just paste these four exports into your shell.)

# HTTPS, and NO port number — the event host terminates TLS on 443. Don't turn
# this into http://...:8000; that path also works, and it would put your team
# key on the wire in cleartext.
export JEOPARDY_BASE_URL=https://REPLACE_WITH_EVENT_HOST
export TEAM_API_KEY=team_REPLACE_WITH_YOUR_KEY

# The event's Claude proxy. Your team key IS the API key. There is no other
# model access, and the proxy forces one model no matter what you request.
export ANTHROPIC_BASE_URL=$JEOPARDY_BASE_URL/anthropic
export ANTHROPIC_API_KEY=$TEAM_API_KEY

# --- optional agent knobs ---
# Nothing auto-loads them. Defaults are competition-oriented and long-running.
# export VERBOSE=1                 # print tool calls and bounded results
# export TASK_FILTER=PR-W5,PR-C5   # restrict work to exact open tile ids
# export MAX_TILES=3               # cap unique tiles; 0/default means all
# export RUN_ONCE=1                # exit after the selected tiles finish
# export DRY_RUN=1                 # solve and verify without submitting
# export MODEL_WORKERS=4           # concurrent Claude/tool loops
# export MAX_TURNS=12              # max calls; lower tiers use smaller budgets
# export MAX_MODEL_TOKENS=1800     # response cap per model call
# export MAX_ATTEMPTS=3            # normal solve attempts before recovery
# export RECOVERY_ATTEMPTS=1       # deferred no-candidate attempts after 60s
# export RECIPE_BACKOFF_SECONDS=30 # family cooldown after a solver exhausts
# export BOARD_POLL_SECONDS=2      # board refresh interval
# export SUBMIT_INTERVAL=3.15      # never set below the server's 3s limit
# export SUBMISSION_SOFT_DEADLINE_SECONDS=15 # age queued answers before staleness
# export MIN_CONFIDENCE=0.82       # structural verification threshold
# export CANDIDATE_BUFFER=16       # pause solving when submissions back up
# export CPU_HEAVY_WORKERS=1       # cap concurrent CPU-heavy deterministic solvers
# export FAST_PATHS=1              # deterministic prompt/file solvers before Claude
# export FAST_PATH_ONLY=0          # calibration: never fall back to Claude
